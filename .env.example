# Demo: synthetic data only. No provider credentials required.
APP_MODE=demo
APP_ORIGIN=http://localhost:4321

# Live: dedicated Postgres connection, server-side only. Use verified TLS remotely.
DATABASE_URL=

# Read-only provider keys. Configure product/campaign scope in business.config.ts.
STRIPE_RESTRICTED_KEY=
META_ACCESS_TOKEN=
# Choose a supported version from your Meta app documentation, for example v25.0.
META_API_VERSION=

# Optional read-only product-event sync. See docs/integrations.md.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_KEY=
# Generate a private random secret (at least 32 characters); keep it stable.
POSTHOG_PSEUDONYM_SECRET=
